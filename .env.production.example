# Copy this file to .env.production and fill in the values.
# .env.production is never committed to git.
#
# These vars are used in two ways:
#   - NEXT_PUBLIC_* → baked into the JS bundle at `docker compose build` time
#   - DATABASE_URL  → injected into the container at runtime only

# ── Supabase (required at BUILD time and runtime) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Database (runtime only) ───────────────────────────────────────────────────
# Use the pgbouncer pooler URL (port 6543) for the app.
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://devfluent.de

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_ANNUAL_ID=
# Optional — only needed if you offer a one-time lifetime purchase
STRIPE_PRICE_LIFETIME_ID=

ANTHROPIC_API_KEY=

# Optional — encrypts stored GitHub access tokens at rest (AES-256-GCM).
# 64 hex characters: generate with `openssl rand -hex 32`. Tokens saved before
# this was set keep working and are encrypted on the next GitHub login/connect.
ENCRYPTION_KEY=
